{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": false,
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "target": "es5",
    "module": "es2015",
    "baseUrl": "./"
  }
}
